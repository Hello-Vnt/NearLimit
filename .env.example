# Frontend (public, baked into the build)
VITE_CONTRACT_ID=            # e.g. nearlimit.your-account.testnet
VITE_RPC_URL=https://test.rpc.fastnear.com
VITE_DEMO_COFFEE=coffee.testnet
VITE_DEMO_HOSTING=host.testnet
VITE_DEMO_OWNER=             # optional: vault shown live on the home page

# Serverless function /api/explain (secret, set in Vercel). Optional:
# without it the app uses the rules-only explanation.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V3.1

# npm run agent:demo
NEARLIMIT_CONTRACT=
AGENT_OWNER=                 # the vault owner's account id
AGENT_KEY=                   # ed25519:... the restricted agent key
